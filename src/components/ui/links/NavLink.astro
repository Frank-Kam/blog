---
const { url, name } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const normalizedUrl = url.replace(/\/$/, '');
const isActive = currentPath === normalizedUrl;

interface Props {
  url: string;
  name: string;
}
---

<a
    id={url === '/' ? 'home' : url.replace(/^\/+|\/+$/g, '')}
    href={url}
    data-astro-prefetch
    class={`rounded-lg text-base font-medium outline-none ring-zinc-500 focus-visible:ring dark:ring-zinc-200 dark:focus:outline-none md:py-3 md:text-sm 2xl:text-base ${
        isActive
            ? 'text-orange-400 dark:text-orange-300'
            : 'text-neutral-600 dark:text-neutral-400 hover:text-neutral-500 dark:hover:text-neutral-500'
    }`}
    aria-current={isActive ? 'page' : undefined}
>
    {name}
</a>

<script>
 document.addEventListener('DOMContentLoaded', () => {
     const url = window.location.pathname.replace('//', '')
     let navId = 'home'

     if (url !== '/') {
         navId = url.replace('/', '')
     }

     const nav = document.getElementById(navId)
     if (nav) {
         nav.classList.remove(
             'text-neutral-600',
             'dark:text-neutral-400',
             'hover:text-neutral-500',
             'dark:hover:text-neutral-500',
         )
         nav.classList.add('text-orange-400', 'dark:text-orange-300')
         nav.setAttribute('aria-current', 'page')
     }
 })
</script>